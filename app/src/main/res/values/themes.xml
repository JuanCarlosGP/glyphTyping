<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nt_black</item>
        <item name="android:colorBackground">@color/nt_black</item>
        <item name="android:textColorPrimary">@color/nt_white</item>
        <item name="android:textColorSecondary">@color/nt_grey</item>
        <item name="android:textColor">@color/nt_white</item>
        <item name="android:colorAccent">@color/nt_white</item>
        <item name="android:colorPrimary">@color/nt_black</item>
        <item name="android:colorControlActivated">@color/nt_white</item>
        <item name="android:statusBarColor">@color/nt_black</item>
        <item name="android:navigationBarColor">@color/nt_black</item>
        <item name="android:buttonStyle">@style/Btn.Secondary</item>
    </style>

    <style name="Dot">
        <item name="android:fontFamily">@font/doto</item>
        <item name="android:fontVariationSettings">\'wght\' 800</item>
        <item name="android:textColor">@color/nt_white</item>
    </style>
    <style name="Dot.Title"><item name="android:textSize">34sp</item></style>
    <style name="Dot.Step">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/nt_grey</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <style name="Body">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/nt_white</item>
    </style>
    <style name="Body.Muted">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nt_grey</item>
    </style>
    <style name="Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/nt_white</item>
        <item name="android:background">@drawable/bg_code</item>
        <item name="android:padding">12dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Btn" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/nt_black</item>
    </style>
    <style name="Btn.Secondary">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/nt_white</item>
    </style>
</resources>
